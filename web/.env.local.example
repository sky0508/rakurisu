# これはテンプレート（git 追跡対象）。実値は web/.env.local（gitignore 済み）に入れる。
# ⚠ ここに本物の secret を書かない。

# Database (Neon) — Pooled 接続。& や $ を含むのでシングルクォート
DATABASE_URL='postgresql://neondb_owner:...@ep-...-pooler....neon.tech/neondb?sslmode=require&channel_binding=require'

# Session (32+ chars). 例: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Google OAuth
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3060/api/auth/google/callback

# ログインを許可するドメイン（任意）。未設定＝どの Google アカウントでもログイン可。
# 絞るなら: ALLOW_DOMAIN=marchon.co.jp
# ALLOW_DOMAIN=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3060
