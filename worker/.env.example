# ワーカー用 env（worker/.env にコピーして値を入れる。gitignore 済み）
# web/.env.local の DATABASE_URL と "同じ値" を使う（同じ Neon を共有）。
# ⚠ & や $ を含むのでシングルクォートで囲む。

DATABASE_URL='postgresql://neondb_owner:...@ep-...-pooler....neon.tech/neondb?sslmode=require&channel_binding=require'

# 必須（与件分解を使う場合）: AI 与件分解 = Gemini。Google AI Studio の無料枠キー。
# レシピ無しで起票したジョブを AI が分解 → ソース発見 → レシピ生成 → dryrun 自動投入する。
GEMINI_API_KEY=...
# 任意: 既定 gemini-2.5-flash。無料枠 RPD に当たると自動で flash-lite にフォールバック。
# GEMINI_MODEL=gemini-2.5-flash

# 必須（与件分解の新規ソース発見 + 本番 Stage2 公式サイト特定）: Brave Search API。
# 新規ソースは Gemini に URL を名指しさせず、Brave 検索の実在 URL からソースを発見する（幻覚回避）。
# 無いと新規ソースの自動発見は不可（既存レシピマッチのみ）＋ Stage2 スキップ（法人リストまで）。
BRAVE_API_KEY=...

# 任意: skill の場所を明示（既定は work-os の .claude/skills/lead-harvest）
# LEADHARVEST_SKILL_DIR=/Users/sorasasaki/work-os/.claude/skills/lead-harvest

# 任意: poll 間隔秒（既定 3）
# LEADHARVEST_POLL_SEC=3
