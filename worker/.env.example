# ワーカー用 env（worker/.env にコピーして値を入れる。gitignore 済み）
# web/.env.local の DATABASE_URL と "同じ値" を使う（同じ Neon を共有）。
# ⚠ & や $ を含むのでシングルクォートで囲む。

DATABASE_URL='postgresql://neondb_owner:...@ep-...-pooler....neon.tech/neondb?sslmode=require&channel_binding=require'

# 任意: 公式サイト特定（Stage2）に使う。無ければ法人リストまで。
# BRAVE_API_KEY=...

# 任意: skill の場所を明示（既定は work-os の .claude/skills/lead-harvest）
# LEADHARVEST_SKILL_DIR=/Users/sorasasaki/work-os/.claude/skills/lead-harvest

# 任意: poll 間隔秒（既定 3）
# LEADHARVEST_POLL_SEC=3
